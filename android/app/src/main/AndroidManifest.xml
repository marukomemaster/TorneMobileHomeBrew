<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app talks to the nasne over the LAN (HTTP / SOAP / SSDP). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Lets the app hold a WifiManager.MulticastLock so SSDP
         M-SEARCH responses are not filtered by the Wi-Fi driver. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- Lets the credential import look for a credentials.env
         file in the Downloads folder (plan 127). Only the legacy
         storage model needs it, hence the maxSdkVersion cap; on
         newer Android the platform side reports the folder as
         unreadable instead and the picker path remains. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Lets the TV edition write the recorded debug logs
         into Downloads/tmhb-log (plan 142). Only the legacy
         storage model needs it, hence the maxSdkVersion cap;
         on API 29+ the platform side writes through
         MediaStore, which asks for nothing. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <!-- Fire TV / Android TV support in this same APK: the TV
         declarations stay optional — leanback is declared
         required=false so Fire TV (which has no leanback
         certification) still installs the app, and a touchscreen
         is not required so remote-only devices qualify. The
         separate "tv" flavor declares the same features in its
         own manifest overlay; declaring them here too makes the
         standard edition itself TV-installable. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false"/>
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"/>
    <application
        android:label="torne mobile HB"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner">
        <activity
            android:name="com.markun.tmhb.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- LAUNCHER is the phone/tablet home screen entry;
                 LEANBACK_LAUNCHER is the Android TV / Fire TV
                 home screen entry. Both point at this one
                 activity, so the same APK appears and launches
                 on TV devices too. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- FileProvider for the debug log share sheet (plan 46).
             Its paths file exposes only the share staging
             subdirectory of the cache dir. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/tmhb_share_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
